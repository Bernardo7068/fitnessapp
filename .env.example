# ==============================================================================
# BInov - Exemplo de Variáveis de Ambiente
# Copie este ficheiro para .env ou servidor/.env e preencha com os seus dados
# ==============================================================================

# Chave de API para o Motor Científico / Coach Cloud (Google Gemini ou OpenAI)
# Pode ser obtida gratuitamente em: https://aistudio.google.com/
CHAVE_API_IA=
GEMINI_API_KEY=

# Configurações do Servidor FastAPI
PORTA_SERVIDOR=8000
HOST_SERVIDOR=0.0.0.0

# Ambiente (desenvolvimento / producao)
AMBIENTE=desenvolvimento
