# ==============================================================================
# BInov - Git Ignore
# ==============================================================================

# --- Bases de Dados e Ficheiros de Estado Local ---
*.db
*.sqlite
*.sqlite3
fitness.db
servidor/fitness.db
servidor/banco_dados.db
substancias_customizadas.json
servidor/substancias_customizadas.json

# --- Ambientes Virtuais e Dependências Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/
env/
ENV/

# --- Node / Interface Web ---
node_modules/
interface/node_modules/
interface/dist/
interface/.vite/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Variáveis de Ambiente & Chaves Secretas ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
servidor/.env
!*.example

# --- Logs e Ficheiros Temporários ---
*.log
logs/
temp/
tmp/

# --- IDEs e Editores de Código ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- Android / Mobile Build Artifacts ---
*.apk
*.aab
interface/android/.gradle/
interface/android/build/
interface/android/app/build/
interface/android/local.properties

# --- Sistema Operativo ---
.DS_Store
Thumbs.db
desktop.ini
local.properties
